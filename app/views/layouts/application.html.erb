<!DOCTYPE html>
<html>
  <head>
    <%= render "layouts/head" %>
  </head>

  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <%= link_to "Members Only", root_path, class: "site-header__brand" %>
        <nav class="site-header__nav">
          <% if user_signed_in? %>
            <span class="site-header__user">Hola, <%= current_user.name %></span>
            <%= link_to "Cerrar sesión", destroy_user_session_path, data: { turbo_method: :delete }, class: "button button--ghost" %>
          <% else %>
            <%= link_to "Iniciar sesión", new_user_session_path %>
            <%= link_to "Crear cuenta", new_user_registration_path, class: "button" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="container">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
