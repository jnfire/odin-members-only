<% content_for :title, "Posts" %>

<div class="page-intro">
  <h1>Members Only</h1>
  <% if user_signed_in? %>
    <p>Bienvenido de nuevo, <%= current_user.name %>. Comparte tu historia con el resto de miembros.</p>
  <% else %>
    <p>
      Este es un sitio solo para miembros. Debes iniciar sesión para ver a los autores de cada historia.
      <%= link_to "Inicia sesión", new_user_session_path %> o <%= link_to "regístrate", new_user_registration_path %>.
    </p>
  <% end %>
</div>

<div id="posts">
  <% if user_signed_in? %>
    <section class="card new-post">
      <h2>Nueva historia</h2>
      <%= render "form", post: @post %>
    </section>
  <% end %>

  <section class="posts-section">
    <h2>Todas las historias</h2>
    <% if @posts.any? %>
      <% @posts.each do |post| %>
        <%= render post %>
      <% end %>
    <% else %>
      <p class="posts-empty">Todavía no hay ninguna historia. ¡Sé el primero en publicar una!</p>
    <% end %>
  </section>
</div>
