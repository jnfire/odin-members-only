<p style="color: green"><%= notice %></p>

<% content_for :title, "Posts" %>

<h1>Members Only</h1>
<p>
  This is a members-only site.
</p>
<% if user_signed_in? %>
  <p>
    Welcome, <%= current_user.name %>!
  </p>
  <%= link_to "Cerrar sesión", destroy_user_session_path, data: { turbo_method: :delete } %>
<% else %>
  <p>
    You must be logged in to view the content authors. If you are not logged in, please <%= link_to "log in", new_user_session_path %> or <%= link_to "sign up", new_user_registration_path %>.
  </p>
<% end %>

<div id="posts">
  <% if user_signed_in? %>
    <section>
      <h2>New story</h2>
      <%= render "form", post: @post %>
    </section>
  <% end %>
  <section>
    <h2>All stories</h2>
    <% @posts.each do |post| %>
      <%= render post %>
    <% end %>
  </section>
</div>
